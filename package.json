{
  "name": "puzzle",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:game": "node scripts/verify-game.mjs",
    "test:audio-auction": "node scripts/verify-audio-auction.mjs",
    "test:selection": "node scripts/verify-selection.mjs",
    "test:profile": "node scripts/verify-profile.mjs",
    "build:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-update.ps1",
    "publish:update": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-update.ps1",
    "publish:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-android.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
