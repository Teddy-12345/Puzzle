{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Puzzle",
  "version": "0.1.3",
  "identifier": "com.puzzle.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Puzzle",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://teddy-personal.cloud:22830 ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwQUMzNjNBREI5QzA5QjgKUldTNENaemJPamFzOEQvK3FkeW1VdjFrZStsUWdEQ1VoK2krRGN3SzVxRGNjaTlXZmxLTUdTUnMK",
      "endpoints": [
        "http://teddy-personal.cloud:22830/files/puzzle/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "dangerousInsecureTransportProtocol": true,
      "requireSignedVersion": true
    }
  }
}
